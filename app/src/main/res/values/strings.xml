    <string name="settings_reminders_guide_title">Reminders not arriving?</string>
    <string name="settings_reminders_guide_generic">Some phones stop apps in the background and lose their alarms. In the app info page, allow auto-start and background activity, and set battery to unrestricted.</string>
    <string name="settings_reminders_guide_coloros">ColorOS / OxygenOS: allow auto-start and background activity, set battery to \"Allow background activity\", and turn off \"Pause app activity if unused\".</string>
    <string name="settings_reminders_guide_xiaomi">Xiaomi / Redmi / POCO: enable Autostart, set battery saver to \"No restrictions\", and lock the app in the recent apps list.</string>
    <string name="settings_reminders_guide_huawei">Huawei / Honor: in app launch, turn off automatic management and allow auto-launch, secondary launch and run in background.</string>
    <string name="settings_reminders_guide_samsung">Samsung: set battery to \"Unrestricted\" and remove the app from \"Sleeping apps\".</string>
    <string name="settings_reminders_guide_vivo">vivo / iQOO: allow auto-start and high background power consumption, and remove the app from the restricted list.</string>
